{
  "name": "wordfeel",
  "version": "1.0.0",
  "description": "Turn any word into probability distributions over taste, material, scent, and shape. Powered by Jev.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "wordfeel": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "analyze": "node --env-file-if-exists=.env src/cli.ts",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts",
    "test": "node --test \"test/*.test.ts\"",
    "test:ui": "vitest run --config web/vitest.config.ts",
    "test:e2e": "playwright test --config web/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "build:app": "npm run build && npm run build:web",
    "dev": "node --watch --env-file-if-exists=.env server/index.ts",
    "start": "node --env-file-if-exists=.env server/index.ts --production",
    "verify": "npm test && npm run test:ui && npm run typecheck && npm run typecheck:web && npm run build:app"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.2.8",
    "@typesafe-ai/sdk": "^0.6.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "typescript": "^5.9.0"
  }
}
