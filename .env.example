# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# The npm scripts load .env with Node's own --env-file-if-exists flag, so no dotenv package is
# involved. If you invoke the library from your own program, load .env yourself (for example
# `node --env-file=.env your-app.js`) or export these in the shell.

# Required. Create one at https://typesafe.ai. Server-side only: never ship it to a browser.
# In the Cloudflare Pages deployment this is a Pages secret, not a variable. See docs/deploy.md.
TYPESAFE_API_KEY=

# Optional. The model wordfeel requests. Defaults to jev-latest.
TYPESAFE_MODEL=jev-latest

# Optional. Per-request timeout in milliseconds. Defaults to 10000.
# Applies to each of the four facet requests independently; retries are disabled, so this is a
# real deadline rather than a budget spread across attempts.
JEV_TIMEOUT_MS=10000

# Optional. Overrides the API root. Only needed to point at a proxy or a test server.
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Web app server. Limits are process-local and reset when the process restarts.
PORT=5173
WORDFEEL_RATE_LIMIT_PER_MINUTE=30
WORDFEEL_MAX_CONCURRENT=4

# Enable only when Wordfeel is behind a trusted reverse proxy that sets X-Forwarded-For.
WORDFEEL_TRUST_PROXY=false
