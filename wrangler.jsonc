{
  // Cloudflare Pages build contract, kept in version control rather than only in the dashboard.
  // See docs/deploy.md.
  //
  // There are no vars and no compatibility_flags here on purpose: TYPESAFE_API_KEY is a Pages
  // secret (never committed), and neither the core nor the TypeSafe SDK touches a Node builtin,
  // so nodejs_compat is not needed.
  "name": "wordfeel",
  "compatibility_date": "2025-09-01",
  "pages_build_output_dir": "web/dist"
}
