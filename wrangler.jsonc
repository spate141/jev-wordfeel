{
  // Cloudflare Worker with static assets, kept in version control rather than only in the
  // dashboard. See docs/deploy.md.
  //
  // There are no vars and no compatibility_flags here on purpose: TYPESAFE_API_KEY is a Worker
  // secret (never committed), and neither the core nor the TypeSafe SDK touches a Node builtin,
  // so nodejs_compat is not needed.
  "name": "wordfeel",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  // Cloudflare creates the DNS record and manages the certificate for this hostname on deploy.
  // One level under snehal.ai, so the zone's existing free wildcard certificate covers it.
  "routes": [
    {
      "pattern": "wordfeel.snehal.ai",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    // An unknown path returns the app rather than a 404; the cabinet is a single page.
    "not_found_handling": "single-page-application",
    // Only the API reaches the Worker. Page loads are served by the assets layer directly, so they
    // cost no Worker invocation and cannot be delayed by it.
    "run_worker_first": ["/api/*"]
  },
  // Per-IP limit on the API, enforced by Cloudflare rather than by an in-process counter (which
  // cannot work across ephemeral isolates). One analysis is one request here but four Jev requests
  // upstream, so this is the ceiling that protects the provider quota from a single actor.
  // `period` accepts only 10 or 60.
  "ratelimits": [
    {
      "name": "ANALYZE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
